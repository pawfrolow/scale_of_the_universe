---
import {
  DONATE_LINK,
  getLocalizedPagePath,
  normalizeText,
} from '@/services/seo-static.service';
import { LANGUAGE_OPTIONS } from '@/config';
import type { TSeoLocale, TSeoPage } from '@/services/seo-static.service';

type Props = {
  locale: TSeoLocale;
  locales: TSeoLocale[];
  page: TSeoPage;
};

const { locale, locales, page } = Astro.props;
const languageLinks = locales
  .filter((entry) => page.type !== 'object' || entry.objects.some((object) => object.id === page.id))
  .map((entry) => ({
    language: entry.language,
    label:
      LANGUAGE_OPTIONS.find((languageOption) => languageOption.code === entry.language)?.label ??
      entry.language,
    path: getLocalizedPagePath(entry, page),
  }));
const modalTitle = normalizeText(locale.ui.html?.modal?.selectLanguage ?? locale.navLabels.language);
const closeModalLabel = normalizeText(
  locale.ui.html?.modal?.closeLanguageModal ?? 'Close language modal',
);
---

<header class="site-header-band">
  <div class="site-header">
    <a class="site-brand" href={locale.path} data-not-found-link="home">
      <img src="/img/favicon/favicon.svg" width="24" height="24" alt="" aria-hidden="true" />
      <span data-not-found-text="appTitle">{locale.appTitle}</span>
    </a>
    <nav class="site-nav" aria-label="Primary">
      <a href={locale.aboutPath} data-not-found-link="about" data-not-found-text="navAbout">{locale.navLabels.about}</a>
      <a href={locale.objectIndexPath} data-not-found-link="objects" data-not-found-text="navObjects">{locale.navLabels.objects}</a>
      <a href="#language-modal" data-language-open data-not-found-text="navLanguage">{locale.navLabels.language}</a>
      <a href={DONATE_LINK} target="_blank" rel="noreferrer" data-not-found-text="navDonate">{locale.navLabels.donate}</a>
    </nav>
    <button
      class="site-menu-button"
      type="button"
      aria-label="Open menu"
      aria-controls="site-nav-sidebar"
      aria-expanded="false"
      data-menu-open
    >
      <img src="/img/icons/menu.svg" width="20" height="20" alt="" aria-hidden="true" />
    </button>
    <div class="site-nav-sidebar-shell" aria-hidden="true" data-menu-shell>
      <button class="site-nav-sidebar-backdrop" type="button" aria-label="Close menu" data-menu-close></button>
      <aside id="site-nav-sidebar" class="site-nav-sidebar" aria-label="Primary">
        <button class="site-nav-sidebar-close" type="button" aria-label="Close menu" data-menu-close>
          <span aria-hidden="true">&times;</span>
        </button>
        <nav class="site-nav-sidebar-links" aria-label="Primary">
          <a href={locale.aboutPath} data-not-found-link="about" data-not-found-text="navAbout">{locale.navLabels.about}</a>
          <a href={locale.objectIndexPath} data-not-found-link="objects" data-not-found-text="navObjects">{locale.navLabels.objects}</a>
          <a href="#language-modal" data-language-open data-not-found-text="navLanguage">{locale.navLabels.language}</a>
          <a href={DONATE_LINK} target="_blank" rel="noreferrer" data-not-found-text="navDonate">{locale.navLabels.donate}</a>
        </nav>
      </aside>
    </div>
    <div id="language-modal" class="language-modal-shell" aria-hidden="true" data-language-shell>
      <a class="language-modal-backdrop" href="#" aria-label={closeModalLabel} data-language-close></a>
      <section
        class="language-modal-dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="language-modal-title"
        tabindex="-1"
        data-language-dialog
      >
        <header class="language-modal-header">
          <h2 id="language-modal-title" data-not-found-text="modalTitle">{modalTitle}</h2>
          <a class="language-modal-close" href="#" aria-label={closeModalLabel} data-language-close>
            <span aria-hidden="true">&times;</span>
          </a>
        </header>
        <nav class="language-modal-list" aria-label={modalTitle}>
          {
            languageLinks.map((link) => (
              <a
                class={`language-modal-option ${link.language === locale.language ? 'is-active' : ''}`}
                href={link.path}
                lang={link.language}
                data-language-option={link.language}
              >
                <span>{link.label}</span>
                {link.language === locale.language ? <span aria-hidden="true" data-language-active-marker>✓</span> : null}
              </a>
            ))
          }
        </nav>
      </section>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const header = document.currentScript?.previousElementSibling;

    if (!header) {
      return;
    }

    const openButton = header.querySelector('[data-menu-open]');
    const closeButtons = header.querySelectorAll('[data-menu-close]');
    const shell = header.querySelector('[data-menu-shell]');
    const languageOpenButtons = header.querySelectorAll('[data-language-open]');
    const languageCloseButtons = header.querySelectorAll('[data-language-close]');
    const languageShell = header.querySelector('[data-language-shell]');
    const languageDialog = header.querySelector('[data-language-dialog]');

    if (!openButton || !shell) {
      return;
    }

    const setLanguageOpen = (isOpen) => {
      if (!languageShell) {
        return;
      }

      languageShell.classList.toggle('is-open', isOpen);
      languageShell.setAttribute('aria-hidden', String(!isOpen));

      if (isOpen) {
        setOpen(false);
        languageDialog?.focus();
      }
    };

    const setOpen = (isOpen) => {
      shell.classList.toggle('is-open', isOpen);
      shell.setAttribute('aria-hidden', String(!isOpen));
      openButton.setAttribute('aria-expanded', String(isOpen));
    };

    openButton.addEventListener('click', () => setOpen(true));
    closeButtons.forEach((button) => {
      button.addEventListener('click', () => setOpen(false));
    });
    shell.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });
    languageOpenButtons.forEach((button) => {
      button.addEventListener('click', (event) => {
        event.preventDefault();
        setLanguageOpen(true);
      });
    });
    languageCloseButtons.forEach((button) => {
      button.addEventListener('click', (event) => {
        event.preventDefault();
        setLanguageOpen(false);
        history.replaceState(null, '', window.location.pathname + window.location.search);
      });
    });
    languageShell?.querySelectorAll('.language-modal-option').forEach((link) => {
      link.addEventListener('click', () => setLanguageOpen(false));
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        if (languageShell?.classList.contains('is-open')) {
          setLanguageOpen(false);
        } else {
          setOpen(false);
        }
      }
    });
  })();
</script>
