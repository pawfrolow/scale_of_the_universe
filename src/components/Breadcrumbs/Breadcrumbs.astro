---
export type BreadcrumbItem = {
  href?: string;
  label: string;
};

type Props = {
  items: BreadcrumbItem[];
};

const { items } = Astro.props;
---

{
  items.length > 0 ? (
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol>
        {items.map((item, index) => {
          const isCurrent = index === items.length - 1;

          return (
            <li>
              {isCurrent || !item.href ? (
                <span aria-current={isCurrent ? 'page' : undefined}>{item.label}</span>
              ) : (
                <a href={item.href}>{item.label}</a>
              )}
            </li>
          );
        })}
      </ol>
    </nav>
  ) : null
}

<style>
  .breadcrumbs {
    margin: 0 0 18px;
    color: rgba(17, 24, 39, 0.62);
    font-size: 0.875rem;
    line-height: 1.35;
  }

  .breadcrumbs ol {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .breadcrumbs li {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .breadcrumbs li:not(:first-child)::before {
    content: "/";
    margin: 0 6px 0 0;
    color: rgba(17, 24, 39, 0.38);
  }

  .breadcrumbs a {
    color: rgba(23, 37, 84, 0.74);
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: #1d4ed8;
  }

  .breadcrumbs span {
    color: rgba(17, 24, 39, 0.72);
  }
</style>
