---
import Breadcrumbs from '@/components/Breadcrumbs/Breadcrumbs.astro';
import Footer from '@/components/Footer/Footer.astro';
import Header from '@/components/Header/Header.astro';
import HeadingWithShadow from '@/components/HeadingWithShadow/HeadingWithShadow.astro';
import SeoLayout from '@/layouts/SeoLayout.astro';
import {
  buildAboutStructuredData,
  buildBreadcrumbStructuredData,
  CONTACT_EMAIL,
  CREDIT_LINKS,
  DEFAULT_LANGUAGE,
  getAppVersion,
  getLocales,
  trimToLength,
} from '@/services/seo-static.service';
import type { TSeoLocale } from '@/services/seo-static.service';

export async function getStaticPaths() {
  const locales = await getLocales();

  return locales
    .filter((locale) => locale.language !== DEFAULT_LANGUAGE)
    .map((locale) => ({
      params: { lang: locale.segment },
      props: { locale },
    }));
}

const locales = await getLocales();
const { locale } = Astro.props as { locale: TSeoLocale };
const appVersion = await getAppVersion();
const title = `${locale.navLabels.about} | ${locale.appTitle}`;
const description = trimToLength(`${locale.metaDescription} ${locale.startScreen.credits.createdBy}`, 155);
const breadcrumbs = [
  { label: locale.appTitle, href: locale.path },
  { label: locale.navLabels.about, href: locale.aboutPath },
];
const originalRepositoryCredit =
  locale.language === DEFAULT_LANGUAGE
    ? 'Оригинальный репозиторий: Мэтью Мартори'
    : locale.startScreen.credits.webDev;
---

<SeoLayout
  canonicalPath={locale.aboutPath}
  description={description}
  locale={locale}
  locales={locales}
  ogImage={locale.ogImage}
  page={{ type: 'about' }}
  structuredData={[buildAboutStructuredData(locale), buildBreadcrumbStructuredData(breadcrumbs)]}
  title={title}
>
  <div class="seo-static-shell">
    <Header locale={locale} locales={locales} appVersion={appVersion} page={{ type: 'about' }} />
    <main class="page">
      <Breadcrumbs items={breadcrumbs} />
      <div class="content-island">
        <HeadingWithShadow text={locale.navLabels.about} />
        {locale.startScreen.introParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        <div class="about-credits">
          <p>
            {locale.startScreen.credits.createdBy}
            {' '}
            <a href={CREDIT_LINKS.copyright} target="_blank" rel="noreferrer">htwins.net</a>
          </p>
          <p>
            {originalRepositoryCredit}
            {' '}
            <a href={CREDIT_LINKS.webDev} target="_blank" rel="noreferrer">github.com</a>
          </p>
          <p>
            {locale.startScreen.credits.translationAndDev}
            {' '}
            <a href={CREDIT_LINKS.pawfrolow} target="_blank" rel="noreferrer">github.com</a>
          </p>
          <p>Email: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
        </div>
        <a class="button" href={locale.objectIndexPath}>{locale.navLabels.objects}</a>
      </div>
    </main>
    <Footer locale={locale} appVersion={appVersion} />
  </div>
</SeoLayout>
