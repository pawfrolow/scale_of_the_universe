{
  "compilerOptions": {
    "jsx": "react",
    "noImplicitAny": false,
    "target": "es2015",
    "sourceMap": true,
    "baseUrl": ".",
    "rootDir": "src",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true
  },
  "exclude": ["node_modules"],
  "include": ["src/**/*", "typings.d.ts"]
}
